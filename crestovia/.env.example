# Copy values into .env.development / .env.production as needed.
# Only VITE_* variables are exposed to the browser (never put secrets here).

# Public site URL
VITE_SITE_URL=https://crestovia.in

# Backend API base URL
# Development: http://localhost:8000
# Production:  https://api.crestovia.in
VITE_API_URL=https://api.crestovia.in

# Optional API key sent as x-api-key
# VITE_API_KEY=crestovia-dev-api-key-change-me

# --- Analytics / Search Console (optional) ---
# Google Analytics 4 measurement ID
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXX
# Google Tag Manager container ID
# VITE_GTM_ID=GTM-XXXXXXX
# Microsoft Clarity project ID
# VITE_CLARITY_ID=
# Meta (Facebook) Pixel ID
# VITE_META_PIXEL_ID=
# Google Search Console HTML tag verification token
# VITE_GSC_VERIFICATION=
