{
  "name": "crestovia-website",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix crestovia",
    "build": "npm run build --prefix crestovia",
    "preview": "npm run preview --prefix crestovia",
    "dev:api": "cd backend && .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start:api": "cd backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1",
    "install:api": "cd backend && /Library/Frameworks/Python.framework/Versions/3.13/bin/python3.13 -m venv .venv && .venv/bin/pip install -r requirements.txt"
  }
}
