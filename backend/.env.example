# Application
APP_NAME=Crestovia API
APP_ENV=development
DEBUG=true

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crestovia?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=crestovia

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Admin credentials (single account)
ADMIN_EMAIL=admin@crestovia.in
ADMIN_PASSWORD=change-me-strong-password

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://crestovia.in

# Cookie
COOKIE_NAME=crestovia_admin_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
