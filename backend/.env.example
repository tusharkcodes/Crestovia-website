# =============================================================================
# Crestovia API — environment template
# Copy to .env on the server and fill in real values. NEVER commit .env.
# =============================================================================

# Application
APP_NAME=Crestovia API
APP_ENV=production
DEBUG=false

# Optional public mount path awareness for OpenAPI (leave empty; Nginx strips nothing)
ROOT_PATH=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crestovia?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=crestovia

# JWT — use a long random secret in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Admin credentials (single account)
ADMIN_EMAIL=admin@crestovia.in
ADMIN_PASSWORD=change-me-strong-password

# CORS — production origins only (never use *)
CORS_ORIGINS=https://crestovia.in,https://www.crestovia.in

# Trusted hosts
ALLOWED_HOSTS=crestovia.in,www.crestovia.in

# Cookie (secure cookies required behind HTTPS)
COOKIE_NAME=crestovia_admin_token
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
